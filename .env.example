# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Postgres connection string. Get one free from https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js ---
# Random secret used to sign session cookies/JWTs. Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
# Canonical URL of the deployed app (used by Auth.js for callbacks). For local dev leave as-is.
AUTH_URL="http://localhost:3000"

# --- Company configuration ---
# IANA timezone the company operates in. All availability/booking rules are interpreted in this zone.
COMPANY_TIMEZONE="Europe/London"
COMPANY_NAME="Acme Consulting"

# --- Email (Resend) ---
# API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sender address (use onboarding@resend.dev for local testing before verifying a domain)
EMAIL_FROM="Acme Consulting <onboarding@resend.dev>"

# --- Reminder cron ---
# Shared secret the cron trigger must present (Vercel Cron sends this automatically as a Bearer token
# when this env var is set on the project). Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-long-random-string"

# --- Public app URL (used in emails for links back to the app) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Seed admin account (used only by `npm run db:seed`, dev/setup only) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
